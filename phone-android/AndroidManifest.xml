<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="kr.newniverse.phone">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <!-- 모두 실행 중 사용자가 '허용'을 눌러야 동작 (앱이 처음 켜질 때 한 번 묻고, 설정 화면에서 다시 물을 수 있음) -->
  <uses-permission android:name="android.permission.CALL_PHONE"/>
  <uses-permission android:name="android.permission.READ_CALL_LOG"/>
  <uses-permission android:name="android.permission.WRITE_CALL_LOG"/>
  <uses-permission android:name="android.permission.READ_CONTACTS"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- v5 상황 모드(운전 중·회의 중): 모드를 처음 켤 때 필요한 것만 묻고, 안 켜면 아무것도 안 해요 -->
  <uses-permission android:name="android.permission.SEND_SMS"/>        <!-- 안 받은 전화에 자동 답장 문자 -->
  <uses-permission android:name="android.permission.READ_SMS"/>        <!-- 선택: 끝난 뒤 「모드 동안 받은 문자」 요약. 허용 안 해도 다른 건 다 돼요 -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE"/> <!-- 기본 전화 앱이 아닐 때만: 안 받은 전화를 알아내려고 -->
  <!-- 방해 금지 접근은 설정 › 알림 › 방해 금지 접근 에서 사용자가 직접 켜는 특별 허용 (선언만 필요) -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/> <!-- 켜 둔 모드의 알람·알림을 폰 재시작 뒤에 다시 걸기 -->
  <!-- v6: 모두 그 기능을 처음 쓸 때만 물어요 -->
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>    <!-- 통화 메모를 말로 받아쓰기 (녹음 파일은 안 만듦) -->
  <uses-permission android:name="android.permission.WRITE_CONTACTS"/>  <!-- 명함 → 주소록 저장 (허용 안 하면 주소록 앱 「새 연락처」 화면으로) -->
  <uses-permission android:name="android.permission.READ_CALENDAR"/>   <!-- 일정 10분 전 「회의 모드 켤까요?」 -->
  <!-- v6 일정 10분 전 알림을 제때 (달력 알림용 정확한 알람, 설치 때 자동) -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
  <!-- ML Kit 내부 기록 모듈이 연결 상태만 확인 (인터넷 권한은 없어서 아무것도 밖으로 못 보냄) -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <!-- 일반 권한 (자동) -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <queries>
    <intent><action android:name="android.intent.action.SENDTO"/><data android:scheme="smsto"/></intent>
    <intent><action android:name="android.intent.action.INSERT"/><data android:mimeType="vnd.android.cursor.dir/raw_contact"/></intent>
    <!-- v6: 받아쓰기 엔진 · 카메라 · 사진 고르기 -->
    <intent><action android:name="android.speech.RecognitionService"/></intent>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE"/></intent>
    <intent><action android:name="android.intent.action.GET_CONTENT"/><data android:mimeType="image/*"/></intent>
  </queries>
  <application android:label="뉴니버스 전화" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
      android:supportsRtl="true" android:usesCleartextTraffic="false" android:allowBackup="false" android:extractNativeLibs="true" android:theme="@style/NV">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
        android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|screenLayout|smallestScreenSize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- 앱 아이콘을 길게 누르면 「운전 중」「회의 중」 바로가기 (누르면 켤지 한 번 묻고 켜요) -->
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
      <!-- 기본 전화 앱 자격: 다이얼 화면 -->
      <intent-filter>
        <action android:name="android.intent.action.DIAL"/>
        <category android:name="android.intent.category.DEFAULT"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.DIAL"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:scheme="tel"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="tel"/>
      </intent-filter>
    </activity>
    <!-- 걸려오는 전화 · 통화 중 화면 (잠금 화면 위에도 뜸) -->
    <activity android:name=".CallActivity" android:exported="false" android:launchMode="singleInstance"
        android:taskAffinity="kr.newniverse.phone.call" android:excludeFromRecents="true"
        android:showWhenLocked="true" android:turnScreenOn="true" android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|screenLayout|smallestScreenSize"/>
    <!-- 기본 전화 앱 자격: 통화 화면 서비스 (벨소리는 시스템이 울림 → IN_CALL_SERVICE_RINGING 선언 안 함) -->
    <service android:name=".CallService" android:exported="true" android:permission="android.permission.BIND_INCALL_SERVICE">
      <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true"/>
      <intent-filter><action android:name="android.telecom.InCallService"/></intent-filter>
    </service>
    <receiver android:name=".CallActionReceiver" android:exported="false"/>
    <!-- v5 상황 모드: 알림 「끄기」·자동 끝내기 알람·답장 결과 (앱 안에서만 부름) -->
    <receiver android:name=".ModeActionReceiver" android:exported="false"/>
    <!-- v5 상황 모드: 시스템 신호(부팅·앱 업데이트·전화 상태) -->
    <receiver android:name=".ModeSystemReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
        <action android:name="android.intent.action.PHONE_STATE"/>
      </intent-filter>
    </receiver>
    <!-- v5 상황 모드: 화면 없이 켜고 끄는 문. 같은 뉴니버스 서명 앱(런처)이 부른 것만 따름 -->
    <activity android:name=".ModeShortcutActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar"
        android:excludeFromRecents="true" android:noHistory="true"/>
    <!-- 기본 전화 앱이면 시스템이 부재중 알림을 이 앱에 맡김 -->
    <receiver android:name=".MissedCallReceiver" android:exported="true">
      <intent-filter><action android:name="android.telecom.action.SHOW_MISSED_CALLS_NOTIFICATION"/></intent-filter>
    </receiver>
    <!-- ===== v6 ===== -->
    <!-- 명함 사진 → 글자 (따로 떨어진 :ocr 프로세스. 앱 안 한국어 모델로 폰 안에서만 읽음) -->
    <activity android:name=".CardScanActivity" android:exported="false" android:process=":ocr"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|screenLayout|smallestScreenSize"/>
    <!-- 카메라 앱이 명함 사진을 써 넣을 임시 칸 (밖에서 못 열고, 그때만 쓰기 허락. 읽고 나면 지움) -->
    <provider android:name=".CardPhotoProvider" android:authorities="kr.newniverse.phone.cardphoto" android:exported="false"
        android:grantUriPermissions="true" android:process=":ocr"/>
    <!-- ML Kit 부품 목록 (시작 프로바이더 MlKitInitProvider 는 넣지 않고, 명함 읽을 때만 직접 켬) -->
    <service android:name="com.google.mlkit.common.internal.MlKitComponentDiscoveryService" android:exported="false" android:directBootAware="true">
      <meta-data android:name="com.google.firebase.components:com.google.mlkit.common.internal.CommonComponentRegistrar" android:value="com.google.firebase.components.ComponentRegistrar"/>
      <meta-data android:name="com.google.firebase.components:com.google.mlkit.vision.text.internal.TextRegistrar" android:value="com.google.firebase.components.ComponentRegistrar"/>
      <meta-data android:name="com.google.firebase.components:com.google.mlkit.vision.common.internal.VisionCommonRegistrar" android:value="com.google.firebase.components.ComponentRegistrar"/>
    </service>
    <activity android:name="com.google.android.gms.common.api.GoogleApiActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:exported="false"/>
    <meta-data android:name="com.google.android.gms.version" android:value="@integer/google_play_services_version"/>
    <!-- ML Kit 사용 기록 모듈: 보낼 곳(backend)을 하나도 등록하지 않아서 기록은 밖으로 안 나감 -->
    <service android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery" android:exported="false" android:process=":ocr"/>
    <service android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService" android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" android:process=":ocr"/>
    <receiver android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver" android:exported="false" android:process=":ocr"/>
  </application>
</manifest>
