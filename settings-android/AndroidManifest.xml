<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="kr.newniverse.settings">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <!-- 밝기·자동 회전 바꾸기: 처음 한 번 사용자가 '시스템 설정 수정'을 허용해야 해요 -->
  <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
  <!-- 무음 모드: 사용자가 '방해 금지 접근'을 허용해야 해요 (허용 목록에 뜨게 하는 선언) -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
  <!-- Wi-Fi 켜짐 여부 읽기만 (일반 권한, 허용 창 없음) -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <queries>
    <package android:name="kr.newniverse.launcher"/>
    <package android:name="kr.newniverse.phone"/>
    <package android:name="kr.newniverse.sms"/>
    <package android:name="kr.newniverse.calc"/>
  </queries>
  <application android:label="뉴니버스 설정" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
      android:supportsRtl="true" android:usesCleartextTraffic="false" android:allowBackup="false" android:theme="@style/NV">
    <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
        android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|density|screenLayout|smallestScreenSize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
